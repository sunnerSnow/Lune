# 全部留空 → 本機示範模式（PGlite 存在 web/.data/pglite，登入頁可一鍵以示範使用者登入）

# Postgres 連線字串（正式環境用 Neon 的 pooled 連線：主機名稱含 -pooler）。設了就切到 Postgres 模式。
DATABASE_URL=
# 選填：Neon 的 direct 連線（主機名稱不含 -pooler），只給 npm run db:migrate 用
DATABASE_URL_UNPOOLED=

# Better Auth：Postgres 模式必填，至少 32 個字元（openssl rand -base64 32）；本機示範模式可留空
BETTER_AUTH_SECRET=
# 選填：網站網址（例如 https://lune.vercel.app）；沒設會從請求推斷
BETTER_AUTH_URL=

# 隱私權政策與使用條款上的聯絡信箱：正式上線前要設定（不把個人信箱寫進程式碼）
LUNE_CONTACT_EMAIL=

# 寄信（Email 驗證、忘記密碼）：gmail | log | none
#   沒設時 next dev 用 log（信印在終端機）、正式建置用 none（不開放忘記密碼與 Email 驗證）
MAIL_PROVIDER=
# MAIL_PROVIDER=gmail 時必填：寄件的 Gmail 帳號與「應用程式密碼」（不是登入密碼；要先開兩步驟驗證）
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 選填：設 1 表示註冊後要先驗證 Email 才能登入（要有寄信服務；本機示範模式不會強制）
AUTH_REQUIRE_EMAIL_VERIFICATION=

# 提醒通知（Web Push）：兩把 VAPID 金鑰都設了，設定頁才會出現「提醒」
#   產生：cd web && npx web-push generate-vapid-keys（私鑰不要貼到任何地方，只放環境變數）
#   金鑰換掉後，所有裝置要重新開啟通知
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 選填：VAPID 聯絡資訊（https: 網址或 mailto:），沒設用 BETTER_AUTH_URL
# VAPID_SUBJECT=
# 排程（Vercel Cron 每天台灣時間 9 點）呼叫 /api/cron/reminders 用的密鑰，至少 32 個字元；Vercel 會自動帶上
CRON_SECRET=

# 選填
# DATABASE_POOL_MAX=5
# PGLITE_DATA_DIR=.data/pglite      # 本機示範資料的位置；memory:// 表示不存檔
# LUNE_LOCAL_MODE=1                 # 只有本機用 next start 示範時才需要；部署在 Vercel 時一律不允許
